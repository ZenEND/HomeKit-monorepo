# Network
# Set to your machine's LAN IP (e.g. 192.168.1.10) to expose services to other devices.
# Run: ipconfig getifaddr en0  (macOS) | hostname -I | awk '{print $1}'  (Linux)
# Leave as "localhost" for same-machine access only.
HOST=localhost

# PostgreSQL
POSTGRES_USER=homekit
POSTGRES_PASSWORD=homekit
POSTGRES_DB=homekit
DB_HOST=postgres
DB_PORT=5432
DB_USER=homekit
DB_PASSWORD=homekit
DB_NAME=homekit

# API
PORT=3000
JWT_KEY=change-me-in-production
JWT_EXPIRES=1d
ADMIN_EMAIL=admin@homekit.local
ADMIN_PASSWORD=admin123456
SIMKL_CLIENT_ID=
SIMKL_APP_NAME=homekit
SIMKL_APP_VERSION=1.0
SIMKL_USER_AGENT=homekit/1.0
SHIKIMORI_APP_NAME=homekit
YANI_APP_TOKEN=

# Web
VITE_API_URL=http://localhost:3000
