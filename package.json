{
  "name": "homekit-monorepo",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build:packages": "pnpm --filter @homekit/engine build && pnpm --filter @homekit/types build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter api --filter web dev",
    "dev:api": "pnpm build:packages && pnpm --filter api start:dev",
    "dev:web": "pnpm build:packages && pnpm --filter web dev",
    "build": "pnpm build:packages && pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm build:packages && pnpm --filter api build",
    "build:web": "pnpm build:packages && pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
